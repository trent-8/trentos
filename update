#!/bin/bash
set -x
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
cp -r ${SCRIPT_DIR}/home ${SCRIPT_DIR}/${USER}
cp -r ${SCRIPT_DIR}/${USER} /home/
rm -r ${SCRIPT_DIR}/${USER}
sudo cp -r ${SCRIPT_DIR}/etc ${SCRIPT_DIR}/usr /
pacman -Qi yay || {
    git clone https://aur.archlinux.org/yay.git
    cd yay
    makepkg -si --noconfirm
    cd ..
    rm -rf yay
}
sudo pacman -Syu --noconfirm
sudo pacman -S --noconfirm --needed - < ${SCRIPT_DIR}/arch-pkg-list
yay -S --noconfirm --needed - < ${SCRIPT_DIR}/aur-pkg-list
cd ${SCRIPT_DIR}/dwm
make clean
sudo make install
sudo systemctl enable NetworkManager.service
sudo systemctl enable bluetooth.service
sudo systemctl enable sshd.service
sudo systemctl enable zram.service
sudo usermod -aG uucp,audio,video,input ${USER}
chsh -s /bin/zsh
sudo chsh -s /bin/zsh

# enable user configuration of fonts
cd /etc/fonts/conf.d
sudo ln -s /usr/share/fontconfig/conf.avail/50-user.conf