#!/usr/bin/env bash
set -x
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
cp -r ${SCRIPT_DIR}/home ${SCRIPT_DIR}/${USER}
cp -r ${SCRIPT_DIR}/${USER} /home/
rm -r ${SCRIPT_DIR}/${USER}
sudo cp -r ${SCRIPT_DIR}/etc ${SCRIPT_DIR}/usr /
gsettings set org.gnome.desktop.interface gtk-theme "Materia-dark-compact"
gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
gsettings set org.gnome.desktop.interface cursor-theme "Breeze_Light"
gsettings set org.gnome.desktop.interface cursor-size 24
cd ${SCRIPT_DIR}/dwm
sudo make install
sudo make clean
# enable user configuration of fonts
cd /etc/fonts/conf.d
sudo ln -s /usr/share/fontconfig/conf.avail/50-user.conf
